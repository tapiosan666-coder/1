; Independent validation project. Does not load FIND YOURSELF game scenes or saves.
config_version=5
[application]
config/name="FIND YOURSELF - 建築仕上げ・出入口 独立検証 v26"
run/main_scene="res://main.tscn"
run/max_fps=144
config/features=PackedStringArray("4.6", "Forward Plus")
[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/vsync/vsync_mode=1
[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true


[debug]
settings/stdout/print_fps=false
